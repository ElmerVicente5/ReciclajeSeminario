generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id       Int        @id @default(autoincrement())
  nombre   String
  usuarios usuarios[]
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  @@index([nombre], map: "roles_nombre")
}

model usuarios {
  id              Int              @id @default(autoincrement())
  nombre_completo String
  contrasenia     String
  rol_id          Int?
  fecha_registro  DateTime?        @default(now()) @db.Timestamp(6)
  estado          String?          @db.VarChar(20)
  nombre_usuario  String           @unique(map: "uq_usuarios_nombreusuario")
  zona_id         Int?
  dispositivos    dispositivos[]
  notificaciones  notificaciones[]
  roles           roles?           @relation(fields: [rol_id], references: [id], onUpdate: NoAction)
  zonas           zonas?           @relation(fields: [zona_id], references: [id], onUpdate: NoAction)

  @@index([estado], map: "idx_usuarios_estado")
  @@index([rol_id], map: "idx_usuarios_rol")
  @@index([zona_id], map: "idx_usuarios_zona")
}

model audiencianotificaciones {
  id              Int            @id @default(autoincrement())
  notificacion_id Int
  tipo_objetivo   String
  objetivo_id     Int?
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  notificaciones  notificaciones @relation(fields: [notificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([notificacion_id], map: "idx_audiencianotificaciones_notificacion")
  @@index([tipo_objetivo, objetivo_id], map: "idx_audiencianotificaciones_objeto")
}

model calendariorecoleccion {
  id          Int      @id @default(autoincrement())
  ruta_id     Int
  dia_semana  Int      @db.SmallInt
  hora_inicio DateTime @db.Time(6)
  hora_fin    DateTime @db.Time(6)
  frecuencia  String?
  notas       String?
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  rutas       rutas    @relation(fields: [ruta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dia_semana], map: "idx_calendario_dia")
  @@index([ruta_id], map: "idx_calendario_ruta")
}

model centrosacopio {
  id        Int     @id @default(autoincrement())
  tipo      String?
  nombre    String
  latitud   Float?
  longitud  Float?
  direccion String?
  zona_id   Int?
  horario   String?
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  zonas     zonas?  @relation(fields: [zona_id], references: [id], onUpdate: NoAction)

  @@index([zona_id], map: "idx_centrosacopio_zona")
}

model dispositivos {
  id_dispositivo   String    @id @db.Uuid
  usuario_id       Int?
  plataforma       String?
  registrado_en    DateTime? @default(now()) @db.Timestamp(6)
  ultima_actividad DateTime? @db.Timestamp(6)
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  usuarios         usuarios? @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ultima_actividad], map: "idx_dispositivos_ultimaactividad")
  @@index([usuario_id], map: "idx_dispositivos_usuario")
}

model eventospuntosporzona {
  id              Int          @id @default(autoincrement())
  zona_id         Int
  tipo_origen     String
  origen_id       Int?
  puntos          Int
  tipo_residuo_id Int?
  fecha_registro  DateTime?    @default(now()) @db.Timestamp(6)
  descripcion     String?
  tiporesiduo     tiporesiduo? @relation(fields: [tipo_residuo_id], references: [id], onUpdate: NoAction)
  zonas           zonas        @relation(fields: [zona_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([fecha_registro], map: "idx_eventos_fecha")
  @@index([tipo_origen, origen_id], map: "idx_eventos_tipo_origen")
  @@index([tipo_residuo_id], map: "idx_eventos_tipo_residuo")
  @@index([zona_id], map: "idx_eventos_zona")
}

model notificaciones {
  id                      Int                       @id @default(autoincrement())
  titulo                  String
  cuerpo                  String?
  tipo                    String?
  creado_por              Int?
  programada_en           DateTime?                 @db.Timestamp(6)
  enviada_en              DateTime?                 @db.Timestamp(6)
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  audiencianotificaciones audiencianotificaciones[]
  usuarios                usuarios?                 @relation(fields: [creado_por], references: [id], onUpdate: NoAction)

  @@index([programada_en], map: "idx_notificaciones_programada")
  @@index([tipo], map: "idx_notificaciones_tipo")
}

model puntosporzona {
  id             Int       @id @default(autoincrement())
  zona_id        Int
  periodo        String
  puntos         Int       @default(0)
  actualizado_en DateTime? @default(now()) @db.Timestamp(6)
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  zonas          zonas     @relation(fields: [zona_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([periodo], map: "idx_puntos_periodo")
  @@index([zona_id], map: "idx_puntos_zona")
}

model rutas {
  id                    Int                     @id @default(autoincrement())
  nombre                String
  zona_id               Int?
  activo                Boolean?                @default(true)
  calendariorecoleccion calendariorecoleccion[]
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  zonas                 zonas?                  @relation(fields: [zona_id], references: [id], onUpdate: NoAction)

  @@index([activo], map: "idx_rutas_activo")
  @@index([zona_id], map: "idx_rutas_zona")
}

model tiporesiduo {
  id                   Int                    @id @default(autoincrement())
  nombre               String
  categoria            String?
  reciclable           Boolean?
  color_contenedor     String?
  eventospuntosporzona eventospuntosporzona[]
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  @@index([nombre], map: "uq_tiporesiduo_nombre")
}

model zonas {
  id                   Int                    @id @default(autoincrement())
  nombre               String
  codigo               String                 @unique
  centrosacopio        centrosacopio[]
  eventospuntosporzona eventospuntosporzona[]
  puntosporzona        puntosporzona[]
  rutas                rutas[]
  usuarios             usuarios[]
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  @@index([codigo], map: "uq_zonas_codigo")
  @@index([nombre], map: "uq_zonas_nombre")
}
